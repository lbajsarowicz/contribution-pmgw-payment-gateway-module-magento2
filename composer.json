{
    "name": "pmgw/payment-gateway-module-magento2",
    "description": "BIG FISH Payment Gateway module for Magento 2",
    "require": {
        "pmgw/payment-gateway-php7-sdk": "4.*",
        "php": "^7.0 | ^8.0"
    },
    "type": "magento2-module",
    "version": "5.6.0",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Bigfishpaymentgateway\\Pmgw\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
